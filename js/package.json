{
  "name": "kalki-wakeword",
  "version": "1.1.0",
  "description": "A 36 KB 'hey kalki' wake word model and streaming detector for the browser and Node.js.",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": { "types": "./index.d.ts", "default": "./index.js" },
    "./model.onnx": "./models/kalki_int4.onnx",
    "./model-int8.onnx": "./models/kalki_int8.onnx"
  },
  "files": ["index.js", "index.d.ts", "models/kalki_int4.onnx", "models/kalki_int8.onnx", "README.md"],
  "scripts": { "test": "node --test test/*.test.js" },
  "keywords": ["wake-word", "onnx", "speech", "hey-kalki"],
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/yeshwanthguru/kalki-wakeword.git", "directory": "js" },
  "homepage": "https://yeshwanthguru.github.io/kalki-wakeword/",
  "engines": { "node": ">=18" },
  "peerDependencies": { "onnxruntime-node": ">=1.17", "onnxruntime-web": ">=1.17" },
  "peerDependenciesMeta": { "onnxruntime-node": { "optional": true }, "onnxruntime-web": { "optional": true } },
  "devDependencies": { "onnxruntime-node": "^1.20.0" }
}
